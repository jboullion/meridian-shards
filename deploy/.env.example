# Copy to deploy/.env and adjust.

# The site's hostname. On the VPS: its external IP with dashes plus .sslip.io,
# e.g. 34-123-45-67.sslip.io (Caddy gets a Let's Encrypt certificate for it).
# Locally: http://localhost (no TLS).
SITE_ADDRESS=http://localhost

# Only allow our apps to open game connections (comma-separated Origin values): the desktop
# app (app://shards), the Android app (https://localhost) and the Unreal client
# (app://meridian-remastered). The browser client isn't hosted, so the site itself isn't
# listed. Empty allows any origin.
# On the VM: GATEWAY_ORIGINS=app://shards,https://localhost,app://meridian-remastered
GATEWAY_ORIGINS=

# Host ports
HTTP_PORT=80
HTTPS_PORT=443
GAME_PORT=5959
