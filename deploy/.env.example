# Copy to deploy/.env and adjust.

# The site's hostname. On the VPS: its external IP with dashes plus .sslip.io,
# e.g. 34-123-45-67.sslip.io (Caddy gets a Let's Encrypt certificate for it).
# Locally: http://localhost (no TLS).
SITE_ADDRESS=http://localhost

# Only allow our own clients to open game connections (comma-separated Origin values): the
# site itself (the browser client), the desktop app (app://shards), the Android app
# (https://localhost) and the Unreal client (app://unreal-meridian). Empty allows any origin.
# On the VM: GATEWAY_ORIGINS=https://34-123-45-67.sslip.io,app://shards,https://localhost,app://unreal-meridian
GATEWAY_ORIGINS=

# The account service (docs/adr/0030-account-recovery.md). ACCOUNTS_SECRET signs the links in its
# emails: 32+ random characters (openssl rand -hex 32); changing it kills links already sent.
# SITE_URL is the origin the links point at. Without RESEND_API_KEY, emails are only logged
# (docker compose logs accounts). TURNSTILE_SECRET is Cloudflare Turnstile's secret key for the
# website's forms; empty skips the check.
ACCOUNTS_SECRET=
SITE_URL=https://m59-shards.com
RESEND_API_KEY=
MAIL_FROM=Meridian Shards <noreply@m59-shards.com>
TURNSTILE_SECRET=

# Host ports
HTTP_PORT=80
HTTPS_PORT=443
GAME_PORT=5959
