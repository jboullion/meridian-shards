# Copy to deploy/.env and adjust.

# The site's hostname. On the VPS: its external IP with dashes plus .sslip.io,
# e.g. 34-123-45-67.sslip.io (Caddy gets a Let's Encrypt certificate for it).
# Locally: http://localhost (no TLS).
SITE_ADDRESS=http://localhost

# Only allow the browser client from our own site to open game connections
# (comma-separated Origin values). Empty allows any origin.
GATEWAY_ORIGINS=

# Host ports
HTTP_PORT=80
HTTPS_PORT=443
GAME_PORT=5959
