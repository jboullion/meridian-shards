# Caddy: HTTPS for the game assets and the WebSocket gateway at /ws. The browser client isn't
# hosted: players use the desktop or Android app, from the download page on GitHub Pages
# (deploy/web/site/download/, .github/workflows/pages.yml), where every other path redirects.
# The apps themselves are GitHub Releases. SITE_ADDRESS is the hostname (e.g.
# 34-123-45-67.sslip.io); Caddy gets its certificate from Let's Encrypt by itself. For a local
# test without TLS, set SITE_ADDRESS=http://localhost.

{$SITE_ADDRESS} {
	encode zstd gzip

	# The game connection
	handle /ws {
		reverse_proxy gateway:8059
	}

	# The original game files. Files are requested with ?v=<content hash>, so they can be
	# cached for good; the manifest that holds the hashes must always be fresh.
	handle /assets/manifest.json {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else, the front page and the old /download/ included, goes to the download page
	handle {
		redir * https://jboullion.github.io/meridian-shards/
	}

	log {
		output stdout
		format console
	}
}
