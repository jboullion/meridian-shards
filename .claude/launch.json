{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stack",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@shards/client"
      ],
      "port": 5173
    },
    {
      "name": "gateway",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/gateway/gateway.ts"
      ],
      "port": 8059
    },
    {
      "name": "client101",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@shards/client",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "env": {
        "SHARDS_GATEWAY": "ws://127.0.0.1:8060"
      },
      "port": 5174
    }
  ]
}
