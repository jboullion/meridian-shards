# Caddy: HTTPS for the site, the game assets, the WebSocket gateway at /ws, and the
# desktop app's download page at /download/ (the installers themselves are on GitHub
# Releases). The browser client isn't hosted: players use the desktop or Android app. SITE_ADDRESS is the hostname (e.g. 34-123-45-67.sslip.io); Caddy
# gets its certificate from Let's Encrypt by itself. For a local test without TLS,
# set SITE_ADDRESS=http://localhost.

{$SITE_ADDRESS} {
	encode zstd gzip

	# The game connection
	handle /ws {
		reverse_proxy gateway:8059
	}

	# The original game files. Files are requested with ?v=<content hash>, so they can be
	# cached for good; the manifest that holds the hashes must always be fresh.
	handle /assets/manifest.json {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The download page (deploy/web/site)
	redir /download /download/
	handle /download/* {
		root * /srv/site
		header Cache-Control "no-cache"
		file_server
	}

	# Everything else, the front page included, goes to the download page
	handle {
		redir * /download/
	}

	log {
		output stdout
		format console
	}
}
